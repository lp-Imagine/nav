# 复制为 deploy/.env 后由 docker compose 读取（勿提交真实密钥）
# cp deploy/.env.production.example deploy/.env

PORT=8787
SESSION_SECRET=请换成足够长的随机字符串
ADMIN_PASSWORD=请设置后台登录密码
GITHUB_TOKEN=
GITHUB_OWNER=lp-Imagine
GITHUB_REPO=nav
GITHUB_BRANCH=main
DB_PATH=data/db.json

FRONTEND_ORIGIN=https://nav.draftly.cn
COOKIE_SECURE=true
PUBLIC_SITE=https://nav.draftly.cn

# 可选 GitHub OAuth（不用可留空）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_CALLBACK_URL=https://nav.draftly.cn/api/auth/github/callback
