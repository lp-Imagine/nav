{
  "name": "nav",
  "version": "6.0.0",
  "private": true,
  "description": "Penn 导航小站 — Astro + React islands",
  "scripts": {
    "dev": "npm run dev --prefix web",
    "dev:api": "npm run dev --prefix server",
    "dev:all": "npx concurrently -k -n web,api -c cyan,green \"npm run dev\" \"npm run dev:api\"",
    "build": "npm run build --prefix web",
    "build:api": "npm run build --prefix server",
    "preview": "npm run preview --prefix web",
    "build:pages": "PUBLIC_BASE=/nav/ npm run build --prefix web"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
